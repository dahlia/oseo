{
  "name": "@oseo/testkit",
  "version": "0.1.0",
  "description": "Cross-host and native fixture support for Oseo tests.",
  "bugs": "https://github.com/dahlia/oseo/issues",
  "license": "GPL-3.0-only",
  "author": {
    "name": "Hong Minhee",
    "email": "hong@minhee.org",
    "url": "https://hongminhee.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dahlia/oseo.git",
    "directory": "packages/testkit"
  },
  "funding": "https://github.com/sponsors/dahlia",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
