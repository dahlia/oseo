      "types": "./dist/test262-summary.d.ts",
      "import": "./dist/test262-summary.js"
    }
  },
  "dependencies": {
    "@oseo/compiler": "workspace:*"
  },
  "engines": {
    "deno": ">=2.9",
    "node": ">=24"
  }
}
